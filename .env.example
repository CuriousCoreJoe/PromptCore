# --- Supabase Keys (from Settings -> API) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey... (Secret key - do not share!)

# --- Google Gemini AI (from AI Studio) ---
GEMINI_API_KEY=AI...

# --- OpenRouter (for multi-model support) ---
OPENROUTER_API_KEY=sk-or-...

# --- Together.ai (for image generation with FLUX) ---
# Get a free key at: https://together.ai
TOGETHER_API_KEY=

# --- Pollinations.ai (FREE image generation - NO API KEY REQUIRED) ---
# Pollinations.ai is used as a fallback for image generation when other services fail
# It's completely free and doesn't require any API key
# Learn more: https://pollinations.ai

# --- Inngest Keys (from Cloud Manage -> API Keys) ---
INNGEST_EVENT_KEY=key_...
INNGEST_SIGNING_KEY=sign_...

# --- Local Dev Settings ---
MOCK_AI=false
NETLIFY_DEV=true
